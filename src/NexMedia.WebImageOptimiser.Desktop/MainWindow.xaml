<Window x:Class="NexMedia.WebImageOptimiser.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexMedia · Web Image Optimiser"
        Width="1120" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Web Image Optimiser" FontSize="24" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Optimise" Padding="18,6" Margin="0,0,8,0" IsEnabled="False" />
                    <Button Content="Cancel" Padding="18,6" IsEnabled="False" />
                </StackPanel>
                <TextBlock Text="0 images" VerticalAlignment="Center" />
            </DockPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="0" Height="8" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Content="Import images…" Padding="12,6" Margin="0,0,8,6" IsEnabled="False" />
                    <Button Content="Import folder…" Padding="12,6" Margin="0,0,8,6" IsEnabled="False" />
                    <Button Content="Select all" Padding="12,6" Margin="0,0,8,6" IsEnabled="False" />
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="Export all successful…" Padding="12,6" Margin="0,0,8,6" IsEnabled="False" />
                    <Button Content="Export selected…" Padding="12,6" Margin="0,0,0,6" IsEnabled="False" />
                </WrapPanel>
                <Grid>
                    <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AutomationProperties.Name="Imported images">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Filename" Width="*" MinWidth="110" />
                            <DataGridTextColumn Header="Format" Width="60" />
                            <DataGridTextColumn Header="Dimensions" Width="95" />
                            <DataGridTextColumn Header="Original size" Width="95" />
                            <DataGridTextColumn Header="Status" Width="85" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False" Margin="16">
                        <TextBlock Text="No images imported" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Planned inputs: JPEG, PNG, WebP and SVG"
                                   Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Starting presets" Padding="12">
                        <StackPanel>
                            <Label Content="Size preset" Target="{Binding ElementName=PresetPicker}" Padding="0,0,0,6" />
                            <ComboBox x:Name="PresetPicker" ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                                      Padding="4" />
                            <TextBlock Text="{Binding PresetDimensions}" Margin="0,12,0,4" TextWrapping="Wrap" />
                            <TextBlock Text="Preserve aspect ratio · No upscaling" TextWrapping="Wrap" />
                            <TextBlock Text="Crop to fill will be an explicit option."
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Planned output defaults" Padding="12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Raster format: WebP" />
                            <TextBlock Text="{Binding DefaultTargetLabel}" Margin="0,8,0,0" />
                            <TextBlock Text="Minimum WebP quality: 60 / 100" Margin="0,8,0,0" />
                            <TextBlock Text="PNG will preserve transparency. SVG will remain vector."
                                       Margin="0,12,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Each selected group will have its own settings."
                                       Margin="0,12,0,12" TextWrapping="Wrap" />
                            <Button Content="Apply to selection" Padding="12,6" IsEnabled="False" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
