<UserControl x:Class="NexMedia.WebImageOptimiser.Desktop.Controls.ReleaseNoteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{Binding Notes.DisplayName}">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Notes.DisplayName}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Padding="9,4" CornerRadius="10" Margin="12,0,0,0"
                        VerticalAlignment="Top" Background="#2A9A61" BorderBrush="#2A9A61" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Latest release" Foreground="White" />
                </Border>
                <Border Padding="9,4" CornerRadius="10" Margin="8,0,0,0"
                        VerticalAlignment="Top" Background="#34689A" BorderThickness="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentVersion}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Your version" Foreground="White" />
                </Border>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Notes.PublishedAt, StringFormat={}{0:d MMM yyyy}}"
                       Style="{StaticResource MutedTextStyle}" Margin="0,6,0,12" />
            <TextBlock Text="{Binding UpdateMessage}"
               TextWrapping="Wrap"
               Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                        BasedOn="{StaticResource MutedTextStyle}">

                        <Setter Property="Visibility" Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateMessage}"
                             Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding UpdateMessage}"
                             Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="{Binding UpdateActionText}" HorizontalAlignment="Left"
                    Margin="0,0,0,12" Click="Update_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowUpdateAction}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBox IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     Background="Transparent" Padding="0"
                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Text" Value="{Binding Notes.Body, Mode=OneWay}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notes.HasNotes}" Value="False">
                                <Setter Property="Text" Value="This release does not have release notes yet." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </StackPanel>
    </Border>
</UserControl>
